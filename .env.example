# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL (docker compose)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/llm_gateway

# Admin API authentication
ADMIN_TOKEN=change-me-to-a-long-random-string

# AES-256-GCM master key for provider API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# OpenRouter (OpenAI-compatible API)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=LLM Gateway Coursework
